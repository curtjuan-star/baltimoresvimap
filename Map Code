    ring_midpoint_ft = (RING_BOUNDARIES_FT[i] + RING_BOUNDARIES_FT[i + 1]) / 2.0
    ring_weights.append(max(0.0, 1.0 - ring_midpoint_ft / SHORELINE_DECAY_DISTANCE_FT))


def compute_area_weighted_shoreline_proximity(csa_geometry):
    csa_area = csa_geometry.area
    if csa_area == 0:
        return 0.0
    total_weight = 0.0
    for ring_poly, weight in zip(ring_polygons, ring_weights):
        if weight <= 0.0:
            continue
        overlap_area = csa_geometry.intersection(ring_poly).area
        total_weight += (overlap_area / csa_area) * weight
    return total_weight


