class YearScoreSlider(MacroElement):
    """Combines a year slider (index into year_order, since years are not
    evenly spaced), a set of radio buttons for score type, and a single
    self-updating gradient legend, all inside ONE collapsible panel.

    Collapsible + a media query keep this usable on narrow phone screens,
    where the previous version (year slider + score radios + separate
    branca legends + an expanded LayerControl) all fought for the same
    space at once.
    """

    _template = Template(u"""
        {% macro script(this, kwargs) %}
        // ---- one-time responsive/collapsible styling ----------------------
        var yssStyle = document.createElement('style');
        yssStyle.innerHTML = `
            .yss-panel {
                background: white;
                font-family: sans-serif;
                width: 240px;
                max-width: 78vw;
                box-sizing: border-box;
                box-shadow: 0 1px 5px rgba(0,0,0,0.4);
                border-radius: 4px;
                overflow: hidden;
            }
            .yss-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 8px 10px;
                font-weight: bold;
                cursor: pointer;
                background: #f4f4f4;
                font-size: 13px;
            }
            .yss-body { padding: 8px 10px 10px 10px; }
            .yss-panel.collapsed .yss-body { display: none; }
            .yss-score-label { display: block; font-size: 12px; margin: 2px 0; }
            .yss-legend-bar {
                height: 10px;
                border-radius: 2px;
                background: linear-gradient(to right, #2ecc71, #f1c40f, #e74c3c);
                margin: 4px 0 2px 0;
            }
            .yss-legend-labels {
                display: flex;
                justify-content: space-between;
                font-size: 10px;
                color: #444;
            }
            @media (max-width: 480px) {
                .yss-panel { width: 210px; max-width: 82vw; }
                .yss-header { font-size: 12px; padding: 6px 8px; }
                .yss-body { padding: 6px 8px 8px 8px; }
                .yss-score-label { font-size: 11px; }
                input[type="range"] { height: 22px; }
            }
        `;
        document.head.appendChild(yssStyle);

        var yearOrder = {{ this.year_order|tojson }};
        var scoreOrder = {{ this.score_order|tojson }};
        var scoreLabels = {{ this.score_labels|tojson }};
        var scoreRanges = {{ this.score_ranges|tojson }};  // {key: [vmin, vmax]}

        // comboLayers[year][scoreKey] = folium layer object
        var comboLayers = {
            {% for year, score_map in this.layer_map.items() %}
            "{{ year }}": {
                {% for score_key, layer_name in score_map.items() %}
                "{{ score_key }}": {{ layer_name }},
                {% endfor %}
            },
            {% endfor %}
        };

        var allComboLayers = [];
        yearOrder.forEach(function(y) {
            scoreOrder.forEach(function(s) {
                allComboLayers.push(comboLayers[y][s]);
            });
        });

        var currentYearIdx = {{ this.default_year_index }};
        var currentScoreKey = "{{ this.default_score_key }}";

        function fmtNum(n) {
            return (Math.round(n * 100) / 100).toString();
        }

        function refreshView() {
            var year = yearOrder[currentYearIdx];
            allComboLayers.forEach(function(layer) {
                {{ this._parent.get_name() }}.removeLayer(layer);
            });
            {{ this._parent.get_name() }}.addLayer(comboLayers[year][currentScoreKey]);
            document.getElementById('yearSliderLabel').innerHTML = year;

            var range = scoreRanges[currentScoreKey];
            document.getElementById('yssLegendMin').innerHTML = fmtNum(range[0]);
            document.getElementById('yssLegendMax').innerHTML = fmtNum(range[1]);
            document.getElementById('yssLegendCaption').innerHTML = scoreLabels[currentScoreKey];
        }

        var YearScoreControl = L.Control.extend({
            options: {position: 'topleft'},
            onAdd: function(map) {
                var container = L.DomUtil.create('div', 'leaflet-bar yss-panel');

                var scoreButtonsHtml = '';
                scoreOrder.forEach(function(key) {
                    var checked = (key === currentScoreKey) ? 'checked' : '';
                    scoreButtonsHtml +=
                        '<label class="yss-score-label">' +
                        '<input type="radio" name="scoreToggle" value="' + key + '" ' + checked + '> ' +
                        scoreLabels[key] + '</label>';
                });

                container.innerHTML =
                    '<div class="yss-header" id="yssHeader">' +
                    '<span>Year: <span id="yearSliderLabel">{{ this.default_year }}</span></span>' +
                    '<span id="yssToggleIcon">&#9650;</span>' +
                    '</div>' +
                    '<div class="yss-body">' +
                        '<input type="range" id="yearSlider" min="0" max="' + (yearOrder.length - 1) +
                        '" step="1" value="{{ this.default_year_index }}" style="width:100%; margin-bottom:8px;">' +
                        '<div style="font-weight:bold; margin-bottom:2px; font-size:12px;">Score:</div>' +
                        scoreButtonsHtml +
                        '<div id="yssLegendCaption" style="font-size:11px; font-weight:bold; margin-top:6px;"></div>' +
                        '<div class="yss-legend-bar"></div>' +
                        '<div class="yss-legend-labels">' +
                            '<span id="yssLegendMin"></span>' +
                            '<span id="yssLegendMax"></span>' +
                        '</div>' +
                    '</div>';

                L.DomEvent.disableClickPropagation(container);
                return container;
            }
        });
        {{ this._parent.get_name() }}.addControl(new YearScoreControl());

        // Collapse/expand toggle (collapsed by default on narrow screens
        // so the panel doesn't sit on top of the map).
        var yssPanelEl = document.querySelector('.yss-panel');
        if (window.innerWidth <= 480) {
            yssPanelEl.classList.add('collapsed');
            document.getElementById('yssToggleIcon').innerHTML = '&#9660;';
        }
        document.getElementById('yssHeader').addEventListener('click', function() {
            yssPanelEl.classList.toggle('collapsed');
            var collapsedNow = yssPanelEl.classList.contains('collapsed');
            document.getElementById('yssToggleIcon').innerHTML = collapsedNow ? '&#9660;' : '&#9650;';
        });

        document.getElementById('yearSlider').addEventListener('input', function(e) {
            currentYearIdx = parseInt(e.target.value, 10);
            refreshView();
        });

        document.querySelectorAll('input[name="scoreToggle"]').forEach(function(radio) {
            radio.addEventListener('change', function(e) {
                currentScoreKey = e.target.value;
                refreshView();
            });
        });

        // Initialize legend text for the default score on first load.
        refreshView();
        {% endmacro %}
    """)

    def __init__(self, layer_map, year_order, score_order, score_labels, score_ranges,
                 default_year, default_score_key):
