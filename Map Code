def calculate_overlap_pct(csa_geometry, reference_union):
    """Returns the fraction (0-1) of a CSA's area that intersects the reference geometry."""
    csa_area = csa_geometry.area
    if csa_area == 0:
        return 0.0
    intersection = csa_geometry.intersection(reference_union)
    return intersection.area / csa_area


