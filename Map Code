def calculate_percentile_rank(series, reverse=False):
    """CDC SVI Ranking formula: (R - 1) / (N - 1)"""
    ascending_order = not reverse
    ranks = series.rank(ascending=ascending_order, method='average')
    min_rank = ranks.min()
    max_rank = ranks.max()
    if max_rank == min_rank:
        return 0.0
    return (ranks - min_rank) / (max_rank - min_rank)



